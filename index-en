<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zhu Jun · Research Interest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #FAFAF8;
      --bg-warm: #F5F3EF;
      --ink: #1A1A2E;
      --ink-soft: #4A4A6A;
      --ink-muted: #8A8AAA;
      --blue: #2563EB;
      --blue-light: #DBEAFE;
      --blue-mid: #3B82F6;
      --red: #DC2626;
      --green: #16A34A;
      --border: #E2E0DC;
      --card: #FFFFFF;
      --shadow: 0 1px 3px rgba(26,26,46,0.06), 0 4px 16px rgba(26,26,46,0.04);
      --shadow-md: 0 4px 12px rgba(26,26,46,0.08), 0 8px 32px rgba(26,26,46,0.06);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Noto Sans SC', 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.8;
    }
    ::selection { background: var(--blue-light); }

    /* ── Nav ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(250,250,248,0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 0 48px;
    }
    .nav-inner {
      max-width: 1080px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; height: 60px;
    }
    .nav-logo { font-size: 15px; font-weight: 600; letter-spacing: 0.5px; }
    .nav-logo span { color: var(--blue); }
    .nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
    .nav-links a { color: var(--ink-soft); text-decoration: none; font-size: 14px; transition: color 0.2s; }
    .nav-links a:hover { color: var(--ink); }
    .lang-toggle {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--card); border: 1px solid var(--border);
      color: var(--ink-soft); padding: 6px 14px; border-radius: 20px;
      font-size: 13px; text-decoration: none; transition: all 0.2s;
    }
    .lang-toggle:hover { border-color: var(--blue); color: var(--blue); }

    /* ── Hero ── */
    .hero {
      padding: 140px 48px 100px;
      max-width: 1080px; margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 64px; align-items: start;
    }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--blue-light); color: var(--blue);
      padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 500;
      margin-bottom: 28px; letter-spacing: 0.5px;
    }
    .hero h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 40px; font-weight: 700; line-height: 1.25;
      margin-bottom: 24px; letter-spacing: -0.3px;
    }
    .hero h1 em { font-style: normal; color: var(--blue); }
    .hero-sub {
      font-size: 17px; color: var(--ink-soft); line-height: 1.8;
      margin-bottom: 32px; max-width: 540px;
    }
    .hero-sub strong { color: var(--ink); font-weight: 600; }
    .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
    .tag {
      display: inline-block; background: var(--bg-warm);
      border: 1px solid var(--border); color: var(--ink-soft);
      padding: 4px 14px; border-radius: 16px; font-size: 13px;
    }
    .hero-actions { display: flex; gap: 12px; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--ink); color: white; padding: 12px 28px;
      border-radius: 8px; font-size: 14px; font-weight: 500;
      text-decoration: none; transition: all 0.2s; border: none; cursor: pointer;
    }
    .btn-primary:hover { background: var(--blue); transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--card); color: var(--ink-soft); padding: 12px 24px;
      border-radius: 8px; font-size: 14px; font-weight: 500;
      text-decoration: none; border: 1px solid var(--border); transition: all 0.2s;
    }
    .btn-secondary:hover { border-color: var(--blue); color: var(--blue); }

    /* ── Hero Side Card ── */
    .hero-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 16px; padding: 28px; min-width: 260px;
      box-shadow: var(--shadow);
    }
    .hero-card-label {
      font-size: 10px; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase; color: var(--ink-muted); margin-bottom: 16px;
    }
    .affiliation-item {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 0; border-bottom: 1px solid var(--border);
    }
    .affiliation-item:last-child { border-bottom: none; }
    .affil-logo {
      width: 32px; height: 32px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700; color: white; flex-shrink: 0;
    }
    .affil-info h4 { font-size: 13px; font-weight: 600; line-height: 1.3; }
    .affil-info p { font-size: 11px; color: var(--ink-muted); margin-top: 1px; }

    /* ── Section base ── */
    .section { padding: 96px 48px; max-width: 1080px; margin: 0 auto; }
    .section-label {
      font-size: 11px; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase; color: var(--blue); margin-bottom: 12px;
    }
    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 30px; font-weight: 700; margin-bottom: 48px;
      letter-spacing: -0.3px;
    }

    /* ── Research Cards ── */
    .research-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
    }
    .research-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 32px;
      box-shadow: var(--shadow); transition: all 0.25s;
      position: relative; overflow: hidden;
    }
    .research-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .research-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--blue);
    }
    .card-label {
      font-size: 10px; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase; color: var(--blue); margin-bottom: 14px;
    }
    .research-card h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px; font-weight: 600; margin-bottom: 12px; line-height: 1.4;
    }
    .research-card p { font-size: 14px; color: var(--ink-soft); line-height: 1.75; }
    .research-card p strong { color: var(--ink); font-weight: 600; }

    /* ── CORE Framework ── */
    .framework-section { background: var(--bg-warm); }
    .framework-inner {
      max-width: 1080px; margin: 0 auto; padding: 96px 48px;
    }
    .core-intro {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 16px; padding: 40px 48px; margin-bottom: 40px;
      display: grid; grid-template-columns: auto 1fr; gap: 48px; align-items: center;
      box-shadow: var(--shadow);
    }
    .core-acronym {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 72px; font-weight: 700; color: var(--blue);
      line-height: 1; opacity: 0.9;
    }
    .core-intro h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px; font-weight: 700; margin-bottom: 12px;
    }
    .core-intro p { font-size: 15px; color: var(--ink-soft); line-height: 1.8; }
    .core-pillars {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    }
    .pillar {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 28px 20px; text-align: center;
      box-shadow: var(--shadow); transition: all 0.25s;
    }
    .pillar:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .pillar-icon { font-size: 28px; margin-bottom: 14px; }
    .pillar h4 { font-size: 14px; font-weight: 600; margin-bottom: 10px; line-height: 1.4; }
    .pillar p { font-size: 12px; color: var(--ink-muted); line-height: 1.65; }

    /* ── Background ── */
    .bg-intro {
      display: grid; grid-template-columns: 1fr auto; gap: 40px;
      align-items: start; margin-bottom: 48px;
    }
    .bg-intro h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px; font-weight: 600; margin-bottom: 12px;
    }
    .bg-intro p { font-size: 15px; color: var(--ink-soft); line-height: 1.8; }
    .stats-row { display: flex; flex-direction: column; gap: 12px; }
    .stat-item {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 10px; padding: 14px 20px; text-align: center;
      box-shadow: var(--shadow);
    }
    .stat-num { font-size: 28px; font-weight: 700; color: var(--blue); font-family: 'Playfair Display', serif; }
    .stat-label { font-size: 11px; color: var(--ink-muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px; }

    .bg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
    .bg-col-header {
      display: flex; align-items: center; gap: 10px; margin-bottom: 24px;
    }
    .bg-col-header h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 17px; font-weight: 600;
    }
    .timeline { position: relative; padding-left: 20px; }
    .timeline::before {
      content: ''; position: absolute; left: 5px; top: 6px; bottom: 6px;
      width: 1px; background: var(--border);
    }
    .timeline-item { position: relative; margin-bottom: 28px; }
    .timeline-item::before {
      content: ''; position: absolute; left: -17px; top: 7px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--blue); border: 2px solid var(--bg);
    }
    .timeline-item .year { font-size: 11px; color: var(--blue); font-weight: 600; margin-bottom: 3px; }
    .timeline-item h4 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
    .timeline-item h4 .highlight { color: var(--blue); font-weight: 500; }
    .timeline-item p { font-size: 13px; color: var(--ink-soft); line-height: 1.65; }

    .institution-badge {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 11px; color: var(--ink-muted);
      background: var(--bg-warm); border: 1px solid var(--border);
      padding: 2px 8px; border-radius: 10px; font-weight: 400;
    }

    /* ── Journey ── */
    .journey-section { background: var(--ink); color: white; }
    .journey-inner {
      max-width: 1080px; margin: 0 auto; padding: 96px 48px;
    }
    .journey-section .section-label { color: rgba(255,255,255,0.45); }
    .journey-section .section-title { color: white; }
    .journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .journey-step {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px; padding: 32px; position: relative;
      transition: all 0.25s;
    }
    .journey-step:hover { background: rgba(255,255,255,0.1); transform: translateY(-2px); }
    .journey-step .step-num {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 48px; font-weight: 700;
      color: rgba(255,255,255,0.06); position: absolute; top: 16px; right: 20px; line-height: 1;
    }
    .journey-step .step-phase {
      font-size: 10px; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase; color: var(--blue-mid); margin-bottom: 12px;
    }
    .journey-step h4 { font-size: 16px; font-weight: 600; margin-bottom: 14px; color: white; }
    .journey-step p { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 16px; }
    .journey-step ul { list-style: none; }
    .journey-step li {
      font-size: 13px; color: rgba(255,255,255,0.5); padding: 3px 0;
      padding-left: 16px; position: relative;
    }
    .journey-step li::before { content: '→'; position: absolute; left: 0; color: var(--blue-mid); font-size: 12px; }

    /* ── Contact ── */
    .contact { text-align: center; padding: 100px 48px; max-width: 680px; margin: 0 auto; }
    .contact h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 34px; font-weight: 700; margin-bottom: 16px; }
    .contact p { color: var(--ink-soft); font-size: 16px; margin-bottom: 40px; line-height: 1.8; }
    .contact-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
    .contact-link {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--card); border: 1px solid var(--border);
      color: var(--ink-soft); padding: 10px 20px; border-radius: 8px;
      font-size: 14px; text-decoration: none; transition: all 0.2s;
    }
    .contact-link:hover { border-color: var(--blue); color: var(--blue); }

    /* ── Footer ── */
    footer {
      text-align: center; padding: 32px 48px;
      border-top: 1px solid var(--border); color: var(--ink-muted); font-size: 12px;
    }
    footer span { color: var(--blue); font-family: 'Playfair Display', Georgia, serif; font-style: italic; }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-card { min-width: unset; }
      .core-intro { grid-template-columns: 1fr; gap: 20px; }
      .core-acronym { font-size: 48px; }
      .research-grid, .bg-grid, .core-pillars, .journey-grid { grid-template-columns: 1fr; }
      .bg-intro { grid-template-columns: 1fr; }
      .nav-links { display: none; }
      .hero h1 { font-size: 30px; }
      .section, .journey-inner, .framework-inner { padding: 60px 24px; }
    }
  </style>
</head>
